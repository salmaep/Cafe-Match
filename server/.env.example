# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=geser
DB_PASSWORD=geser_pass
DB_DATABASE=geser

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRATION=7d

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=5084
NODE_ENV=production

# Public web origin used to build absolute URLs in /sitemap.xml and /robots.txt.
# No trailing slash.
PUBLIC_WEB_URL=https://geser.id

# Public API base used to build absolute URLs for uploaded/synced files
# (storage/*). MUST include the /api/v1 suffix — without it, stored photo
# URLs fall back to http://localhost:3000/api/v1 and break in production.
PUBLIC_API_URL=https://api.geser.id/api/v1

# ─── Payments (Midtrans) ──────────────────────────────────────────────────────
# Server only needs the server key; the client key lives in the frontend.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# ─── Dev Toggles ──────────────────────────────────────────────────────────────
CHECKIN_SKIP_GPS=false
# GPS gate radius for check-in (meters). Default 500 when unset.
CHECKIN_RADIUS_METERS=500

# ─── Tables (Open/Join Table) ─────────────────────────────────────────────────
# Max lifetime of an open table before auto-expiry (hours). Default 8.
TABLE_MAX_DURATION_HOURS=8
# Allow gender-based join rules ("perempuan saja"). Default true.
TABLE_GENDER_RULES_ENABLED=true

# ─── Admin API key ────────────────────────────────────────────────────────────
# Used by /admin/meili/* and purposes admin (infra ops).
# Sent via x-api-key header.
ADMIN_API_KEY=change-this-to-a-strong-random-key

# ─── Scraper API key ─────────────────────────────────────────────────────────
# Used by /sync/cafes and /sync/cafe-photos (machine ingest from the scraper).
# Sent via x-api-key header; must match the scraper's SYNC_API_KEY.
SCRAPER_API_KEY=change-this-to-a-strong-random-key

# ─── Meilisearch ─────────────────────────────────────────────────────────────
# When NestJS runs on HOST (dev): http://localhost:7700
# When NestJS runs in Docker container: http://meilisearch:7700 (overridden by docker-compose.yml)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=change-this-to-a-strong-random-key
MEILI_CAFES_INDEX=cafes
# MEILI_ENV: 'development' enables web UI at :7700, 'production' disables it
MEILI_ENV=development

# Sync behavior
# MEILI_SYNC_ENABLED=false  → disable all Meili sync (emergency MySQL-only mode)
MEILI_SYNC_ENABLED=true

# ─── Email (OTP via Gmail OAuth2 / nodemailer) ───────────────────────────────
# Login OTP is emailed (nodemailer + Gmail OAuth2). Set LOGIN_OTP_ENABLED=false
# ONLY as an emergency switch to let password logins through without an OTP.
LOGIN_OTP_ENABLED=true
# Display name + address in the From header. With Gmail OAuth2 the address is
# forced to the authenticated account unless you have a verified alias/Workspace.
MAIL_FROM="Geser <no-reply@geser.id>"
# The Gmail account that sends (must match the account you authorized below).
GMAIL_OAUTH_USER=
# Dedicated OAuth 2.0 "Web application" client for Gmail send.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Refresh token from OAuth Playground (scope https://mail.google.com/), obtained
# by the GMAIL_OAUTH_USER account.
GMAIL_REFRESH_TOKEN=
# OTP tuning (optional — sensible defaults applied if unset).
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ─── Social Auth (Google) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5084/api/v1/auth/google/callback

# ─── Social Auth (Facebook) ──────────────────────────────────────────────────
FB_APP_ID=
FB_APP_SECRET=
FB_CALLBACK_URL=http://localhost:5084/api/v1/auth/facebook/callback

# Frontend URL OAuth flows redirect to after success (no trailing slash)
OAUTH_REDIRECT_URL=http://localhost:5083/auth/callback
